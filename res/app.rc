// =====================================================================
//  PDFForge  -  app.rc : version info, icon, manifest
//  Author : Ragul S
// =====================================================================
#include <winver.h>

#define APP_ICON_ID        1
#define APP_MANIFEST_ID    1
#ifndef RT_MANIFEST
#define RT_MANIFEST        24
#endif

APP_ICON_ID     ICON     "app.ico"
APP_MANIFEST_ID RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Ragul S"
            VALUE "FileDescription",  "PDFForge - every PDF tool you need, in one offline app"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "PDFForge"
            VALUE "LegalCopyright",   "Copyright \251 2026 Ragul S. All rights reserved."
            VALUE "OriginalFilename", "PDFForge.exe"
            VALUE "ProductName",      "PDFForge"
            VALUE "ProductVersion",   "1.0.0.0"
            VALUE "Comments",         "Processes every file on this PC. Nothing is uploaded."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
